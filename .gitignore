node_modules/
**/node_modules/

# Environment variables — NEVER commit real .env
.env
**/.env

# Build output
dist/
build/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# Uploads (user-uploaded files)
uploads/
temp/

# Misc
.idea/
*.swp
